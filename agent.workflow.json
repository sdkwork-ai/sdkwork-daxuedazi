{
  "$schema": "../sdkwork-github-workflow/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "workflowRole": "fork-upstream",
  "app": {
    "id": "sdkwork-birdcoder2",
    "name": "学伴AI",
    "repository": "sdkwork-ai/sdkwork-daxuedazi",
    "sourcePath": ".",
    "configPath": "agent.app.config.json"
  },
  "release": {
    "artifactPrefix": "daxuedazi",
    "defaultVersion": "0.2.3-alpha.2",
    "changelog": {
      "source": "auto",
      "maxCommitSubjects": 50
    }
  },
  "toolchains": {
    "node": "22",
    "pnpm": "11.7.0"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install harness workspace dependencies",
        "shell": "node",
        "run": "corepack enable && corepack prepare pnpm@11.7.0 --activate && pnpm install --frozen-lockfile"
      }
    ],
    "build": [
      {
        "name": "Build harness release artifacts",
        "shell": "node",
        "run": "pnpm run build"
      }
    ],
    "package": [
      {
        "name": "Package container image bundle",
        "shell": "node",
        "run": "pnpm run release:pack-container"
      }
    ],
    "validate": [
      {
        "name": "Validate container bundle",
        "shell": "node",
        "run": "pnpm run release:verify-container-bundle"
      }
    ],
    "sbom": [
      {
        "name": "Generate SPDX SBOM",
        "run": "syft dir:. -o spdx-json=dist/sbom.spdx.json"
      }
    ]
  },
  "targets": [
    {
      "id": "windows-x64-standalone-desktop-exe",
      "profile": "desktop",
      "platform": "windows",
      "architecture": "x64",
      "formats": [
        "exe"
      ],
      "runner": "windows-2022",
      "outputGlobs": [
        "artifacts/release/**/*"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop"
    },
    {
      "id": "macos-arm64-standalone-desktop-dmg",
      "profile": "desktop",
      "platform": "macos",
      "architecture": "arm64",
      "formats": [
        "dmg"
      ],
      "runner": "macos-15",
      "outputGlobs": [
        "artifacts/release/**/*"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop"
    },
    {
      "id": "linux-x64-standalone-desktop-appimage",
      "profile": "desktop",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "appimage"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "artifacts/release/**/*"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop"
    },
    {
      "id": "container-x64-cloud-container-cpu-tar-gz",
      "profile": "container",
      "platform": "container",
      "architecture": "x64",
      "variant": "cpu",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "artifacts/release/**/*"
      ],
      "deploymentProfile": "cloud",
      "runtimeTarget": "container"
    },
    {
      "id": "web-universal-cloud-browser-tar-gz",
      "profile": "browser",
      "platform": "web",
      "architecture": "universal",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "artifacts/release/**/*"
      ],
      "deploymentProfile": "cloud",
      "runtimeTarget": "browser"
    }
  ],
  "security": {
    "oidcRequired": false,
    "artifactAttestations": false,
    "sbomRequired": true,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": true,
    "aggregateRelease": false,
    "retentionDays": 30
  },
